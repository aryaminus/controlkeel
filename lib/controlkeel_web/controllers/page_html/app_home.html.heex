<div
  id="app-home"
  data-app-home
  data-home-fallback={@default_path}
  data-home-has-orgs={to_string(@has_orgs)}
  data-home-show-form={to_string(@error != nil)}
  class="flex min-h-screen items-center justify-center bg-background text-foreground"
>
  <div id="app-home-loading" class="flex flex-col items-center gap-4">
    <span class="flex size-12 items-center justify-center rounded-2xl bg-primary text-primary-foreground shadow-lg shadow-primary/20">
      <.icon name="hero-bolt-solid" class="size-6 motion-safe:animate-pulse" />
    </span>
    <p class="text-sm text-muted-foreground">Opening your workspace…</p>
  </div>

  <div id="app-home-create" class="hidden w-full max-w-md px-4">
    <div class="overflow-hidden rounded-[2rem] border bg-card/95 p-8 text-center shadow-[0_45px_120px_-40px_rgba(0,0,0,0.9)]">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-3xl border bg-muted">
        <.icon name="hero-building-office-2" class="size-7 text-primary" />
      </div>
      <h1 class="text-3xl font-semibold tracking-tight text-foreground">
        No organizations yet
      </h1>
      <p class="mt-3 text-sm leading-6 text-muted-foreground">
        Create an organization to group workspaces, members, and budgets —
        you need one before anything else.
      </p>

      <%= if @error do %>
        <p class="mt-4 rounded-xl bg-destructive/10 px-3 py-2 text-sm text-destructive">
          {@error}
        </p>
      <% end %>

      <form method="post" action={~p"/orgs"} class="mt-6 space-y-4 text-left">
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <div>
          <label for="org_name" class="mb-1.5 block text-sm font-medium text-foreground">
            Name
          </label>
          <input
            type="text"
            id="org_name"
            name="org[name]"
            value={@name}
            placeholder="Acme Inc"
            required
            autofocus
            class="w-full rounded-xl border border-input bg-background px-3 py-2 text-sm text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
        </div>
        <div>
          <label for="org_slug" class="mb-1.5 block text-sm font-medium text-foreground">
            Slug
          </label>
          <input
            type="text"
            id="org_slug"
            name="org[slug]"
            value={@slug}
            placeholder="Auto-generated from name"
            class="w-full rounded-xl border border-input bg-background px-3 py-2 text-sm text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          />
          <p class="mt-1.5 text-xs text-muted-foreground">
            Lowercase letters, numbers, and hyphens. Used in URLs.
          </p>
        </div>
        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90"
        >
          <.icon name="hero-plus" class="size-4" /> Create organization
        </button>
      </form>
    </div>
  </div>

  <noscript>
    <p class="text-sm text-muted-foreground">
      <a href={@default_path} class="underline">Continue to your organization</a>
    </p>
  </noscript>
</div>
