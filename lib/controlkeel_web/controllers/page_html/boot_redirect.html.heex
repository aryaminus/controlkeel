<div
  id="boot-redirect"
  data-boot-redirect
  data-boot-fallback={@default_path}
  class="flex min-h-screen items-center justify-center bg-background text-foreground"
>
  <div class="flex flex-col items-center gap-4">
    <span class="flex size-12 items-center justify-center rounded-2xl bg-primary text-primary-foreground shadow-lg shadow-primary/20">
      <.icon name="hero-bolt-solid" class="size-6 motion-safe:animate-pulse" />
    </span>
    <p class="text-sm text-muted-foreground">Opening your workspace…</p>
    <noscript>
      <p class="text-sm text-muted-foreground">
        <a href={@default_path} class="underline">Continue to your organization</a>
      </p>
    </noscript>
  </div>
</div>
