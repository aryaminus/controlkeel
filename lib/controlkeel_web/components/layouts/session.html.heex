<div class="h-screen flex overflow-hidden">
  <.session_sidebar
    current_user={@current_user}
    current_path={@current_path}
    session={assigns[:session]}
    session_id={assigns[:session_id]}
    session_title={assigns[:session_title]}
    session_risk={assigns[:session_risk]}
  />

  <div class="flex flex-1 flex-col overflow-hidden">
    <.dashboard_header
      current_path={@current_path}
      page_action={assigns[:page_action]}
      breadcrumbs={assigns[:breadcrumbs]}
    />

    <main class="flex-1 overflow-y-auto">
      <div class="px-4 pt-6 pb-12 sm:px-8 lg:px-8 container mx-auto">
        {@inner_content}
      </div>
    </main>
  </div>
</div>

<.flash_group flash={@flash} />
