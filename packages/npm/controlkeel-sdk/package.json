{
  "name": "@aryaminus/controlkeel-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the ControlKeel cloud governance API (/cloud/v1).",
  "license": "Apache-2.0",
  "author": {
    "name": "aryaminus",
    "url": "https://github.com/aryaminus"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryaminus/controlkeel.git",
    "directory": "packages/npm/controlkeel-sdk"
  },
  "homepage": "https://github.com/aryaminus/controlkeel/tree/main/packages/npm/controlkeel-sdk#readme",
  "bugs": {
    "url": "https://github.com/aryaminus/controlkeel/issues"
  },
  "keywords": [
    "controlkeel",
    "governance",
    "sdk",
    "cloud",
    "api",
    "typescript",
    "ai-safety",
    "agent-governance"
  ],
  "type": "module",
  "main": "./dist-cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('dist-cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test src/client.test.mjs src/package.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
