# ControlKeel local environment example
# IMPORTANT: never commit real secrets. Copy this file to .env for local use,
# and use platform-managed secrets for production/cloud deployments.

# Application
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_mix_phx.gen.secret

# Local storage (default runtime mode)
# ControlKeel uses SQLite locally unless CONTROLKEEL_RUNTIME_MODE=cloud is set.
DATABASE_PATH=./controlkeel_dev.db
POOL_SIZE=10

# Cloud/runtime mode only
# CONTROLKEEL_RUNTIME_MODE=cloud
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE
# ECTO_USE_SSL=true

# OAuth providers — set both client_id and client_secret to activate a provider.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Public base URL for OAuth redirect URIs (defaults to http://localhost:4000).
# CONTROLKEEL_OAUTH_BASE_URL=
