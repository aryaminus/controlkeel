#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$ROOT_DIR"

_has_json_flag() {
  for arg in "$@"; do
    case "$arg" in
      --json|--format=json|--format=JSON)
        return 0
        ;;
      *)
        ;;
    esac
  done
  for i in $(seq 1 $#); do
    eval "arg=\${$i}"
    if [ "$arg" = "--format" ]; then
      next=$((i + 1))
      if [ "$next" -le "$#" ]; then
        eval "val=\${$next}"
        case "$val" in
          json|JSON) return 0 ;;
        esac
      fi
    fi
  done
  return 1
}

if _has_json_flag "$@"; then
  # CK_CLI_MODE skips Phoenix listeners/reloaders; do not set MIX_QUIET here —
  # Mix suppresses Mix.shell().info output when MIX_QUIET=1, which breaks JSON
  # emitted by mix ck.context / ck.validate (used by Cursor hooks).
  export CK_CLI_MODE=1
  export LOGGER_LEVEL=error
  # Mix may recompile when CK_CLI_MODE changes compile-time configuration. Keep
  # that progress off stdout so machine consumers receive exactly one JSON value.
  mix compile >/dev/null
fi

CMD="$1"
if [ -z "$CMD" ]; then
  mix run -e 'ControlKeel.CLI.parse(["--help"]) |> elem(1) |> ControlKeel.CLI.run_command(File.cwd!()) |> elem(1) |> Enum.each(&IO.puts/1)'
  exit 0
fi

if [ "$CMD" = "context" ]; then
  shift
  mix ck.context "$@"
elif [ "$CMD" = "validate" ]; then
  shift
  mix ck.validate "$@"
elif [ "$CMD" = "finding" ]; then
  shift
  mix ck.findings "$@"
else
  mix run -e '
    argv = System.argv()
    json? = ControlKeel.CLI.Output.json_requested?(argv)

    case ControlKeel.CLI.parse(argv) do
      {:ok, parsed} ->
        System.halt(ControlKeel.CLI.execute(parsed, []))

      {:error, message} ->
        if json? do
          IO.puts(ControlKeel.CLI.Output.error_json(message, :parse_error, nil))
        else
          IO.puts(:stderr, message)
        end
        System.halt(1)
    end
  ' -- "$@"
fi
